{
  "name": "optica_app",
  "version": "1.1.0",
  "description": "App para la gestión de fórmulas ópticas",
  "main": "js/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "nodemon --watch . --exec electron .",
    "test": "node --test",
    "postinstall": "node scripts/verificar-electron.js",
    "reparar-electron": "node scripts/verificar-electron.js",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --dir"
  },
  "keywords": [],
  "author": "Daniel RoMo DEV",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^35.0.3",
    "electron-builder": "^26.18.0",
    "nodemon": "^3.1.9"
  },
  "dependencies": {
    "call-bind-apply-helpers": "^1.0.2",
    "sqlite3": "^5.1.7"
  },
  "build": {
    "appId": "com.optica.app",
    "productName": "OpticaApp",
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "js/**/*",
      "images/**/*",
      "package.json",
      "!**/*.map",
      "!**/{CHANGELOG.md,README.md,README,readme.md,readme,LICENSE,license}",
      "!dist/**/*",
      "!db/**/*",
      "!test/**/*",
      "!scripts/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "images/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
